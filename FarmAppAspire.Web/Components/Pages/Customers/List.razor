@page "/customers"
@rendermode InteractiveServer
@attribute [Authorize]
@inject CustomerApiClient CustomerApi
@implements IDisposable

<PageTitle>Customers</PageTitle>

<h1>Customers</h1>

<AuthorizeView Roles="FarmAdmin">
    <Authorized>
        <a href="/customers/create" class="btn btn-primary mb-3">New Customer</a>
    </Authorized>
</AuthorizeView>

@if (_customers is null)
{
    <p><em>Loading...</em></p>
}
else if (!_customers.Any())
{
    <p>No customers found.</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                    <th>Customer Key</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Channel</th>
                    <th>Company</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th class="text-center">Orders</th>
                    <th class="text-end">Total</th>
                    <th></th>
                </tr>
        </thead>
        <tbody>
            @foreach (var c in _customers)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(c.CustomerKey))
                        {
                            <a href="/customers/@c.Id" class="fw-bold font-monospace text-decoration-none fs-6">
                                @c.CustomerKey
                            </a>
                            @if (c.CustomerKeyCollision)
                            {
                                <span class="badge bg-warning text-dark ms-1" title="Key collision detected">⚠</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted small fst-italic">No key</span>
                        }
                    </td>
                    <td><a href="/customers/@c.Id">@c.DisplayName</a></td>
                    <td>@c.Type</td>
                    <td>@c.ChannelType</td>
                    <td>@c.CompanyName</td>
                    <td>@c.PrimaryEmail</td>
                    <td>@c.PrimaryPhone</td>
                    <td class="text-center">@c.OrderCount</td>
                    <td class="text-end">@c.TotalOrderAmount.ToString("C")</td>
                    <td>
                        <AuthorizeView Roles="FarmAdmin">
                            <Authorized>
                                <a href="/customers/@c.Id/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
                            </Authorized>
                        </AuthorizeView>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private CustomerSummary[]? _customers;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        _customers = await CustomerApi.GetCustomersAsync(
            cancellationToken: _cts.Token);
    }

    public void Dispose() => _cts.Cancel();
}
