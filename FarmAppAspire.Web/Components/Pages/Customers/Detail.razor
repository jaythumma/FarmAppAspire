@page "/customers/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject CustomerApiClient CustomerApi
@inject OrderApiClient OrderApi
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Customer Detail</PageTitle>

@if (_customer is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="d-flex align-items-center gap-2 mb-3">
        <h1 class="mb-0">@_customer.DisplayName</h1>
        <AuthorizeView Roles="FarmAdmin">
            <Authorized>
                <a href="/customers/@_customer.Id/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
            </Authorized>
        </AuthorizeView>
    </div>

    @* ── Customer Key Banner ─────────────────────────────────────────────── *@
    <div class="card mb-4 border-primary">
        <div class="card-body py-3">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold letter-spacing-1">Customer Key</span>
                    @if (!string.IsNullOrEmpty(_customer.CustomerKey))
                    {
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <span class="fw-bold font-monospace fs-3 text-primary">@_customer.CustomerKey</span>
                            @if (_customer.CustomerKeyCollision)
                            {
                                <span class="badge bg-warning text-dark fs-6" title="This key is in use by another customer — resolve manually">
                                    ⚠ Collision
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="mt-1">
                            <span class="text-muted fst-italic fs-5">No key assigned</span>
                        </div>
                    }
                </div>
                <AuthorizeView Roles="FarmAdmin">
                    <Authorized>
                        <div class="ms-auto d-flex align-items-center gap-2">
                            @if (_customer.ChannelType == ChannelType.Amazon)
                            {
                                <span class="badge bg-secondary text-white">Auto-generated (Amazon)</span>
                            }
                            else if (_keyEditMode)
                            {
                                <input type="text" class="form-control form-control-sm font-monospace"
                                       style="width:160px"
                                       @bind="_keyEditValue"
                                       placeholder="KEY-VALUE"
                                       maxlength="30" />
                                <button class="btn btn-sm btn-primary" @onclick="SaveKeyAsync">Save</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _keyEditMode = false">Cancel</button>
                            }
                            else
                            {
                                @if (string.IsNullOrEmpty(_customer.CustomerKey))
                                {
                                    <button class="btn btn-sm btn-primary" @onclick="GenerateKeyAsync">
                                        Generate Key
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="GenerateKeyAsync">
                                        Regenerate
                                    </button>
                                }
                                <button class="btn btn-sm btn-outline-secondary" @onclick="StartKeyEdit">
                                    Edit Key
                                </button>
                            }
                            @if (_keyError is not null)
                            {
                                <span class="text-danger small">@_keyError</span>
                            }
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <h5>Customer Info</h5>
            <dl class="row">
                <dt class="col-sm-4">Type</dt>
                <dd class="col-sm-8">@_customer.Type</dd>

                <dt class="col-sm-4">Channel</dt>
                <dd class="col-sm-8">@_customer.ChannelType</dd>

                @if (!string.IsNullOrEmpty(_customer.CompanyName))
                {
                    <dt class="col-sm-4">Company</dt>
                    <dd class="col-sm-8">@_customer.CompanyName</dd>
                }

                @if (!string.IsNullOrEmpty(_customer.TaxId))
                {
                    <dt class="col-sm-4">Tax ID</dt>
                    <dd class="col-sm-8">@_customer.TaxId</dd>
                }

                @if (!string.IsNullOrEmpty(_customer.PrimaryEmail))
                {
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@_customer.PrimaryEmail</dd>
                }

                @if (!string.IsNullOrEmpty(_customer.PrimaryPhone))
                {
                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@_customer.PrimaryPhone</dd>
                }

                @if (_customer.PaymentTerms.HasValue)
                {
                    <dt class="col-sm-4">Payment Terms</dt>
                    <dd class="col-sm-8">@_customer.PaymentTerms</dd>
                }

                @if (!string.IsNullOrEmpty(_customer.Notes))
                {
                    <dt class="col-sm-4">Notes</dt>
                    <dd class="col-sm-8">@_customer.Notes</dd>
                }

                <dt class="col-sm-4">Orders</dt>
                <dd class="col-sm-8">@_customer.OrderCount</dd>

                <dt class="col-sm-4">Order Total</dt>
                <dd class="col-sm-8">@_customer.TotalOrderAmount.ToString("C")</dd>
            </dl>
        </div>

        <div class="col-md-6">
            @{
                var shippingAddr = _customer.Addresses.FirstOrDefault(a => a.Type == AddressType.Shipping);
                var billingAddr = _customer.Addresses.FirstOrDefault(a => a.Type == AddressType.Billing);
            }

            @if (shippingAddr is not null)
            {
                <h5>Shipping Address</h5>
                <address>
                    @shippingAddr.Line1<br />
                    @if (!string.IsNullOrEmpty(shippingAddr.Line2))
                    {
                        @shippingAddr.Line2<br />
                    }
                    @shippingAddr.City, @shippingAddr.State @shippingAddr.PostalCode<br />
                    @shippingAddr.Country
                </address>
            }

            <h5>Billing Address</h5>
            @if (_customer.BillingUsesShipping)
            {
                <span class="badge bg-secondary">Same as shipping address</span>
            }
            else if (billingAddr is not null)
            {
                <address>
                    @billingAddr.Line1<br />
                    @if (!string.IsNullOrEmpty(billingAddr.Line2))
                    {
                        @billingAddr.Line2<br />
                    }
                    @billingAddr.City, @billingAddr.State @billingAddr.PostalCode<br />
                    @billingAddr.Country
                </address>
            }
            else
            {
                <p class="text-muted">Billing address not set.
                    <AuthorizeView Roles="FarmAdmin">
                        <Authorized>
                            <a href="/customers/@_customer.Id/edit">Add billing address</a>
                        </Authorized>
                    </AuthorizeView>
                </p>
            }
        </div>
    </div>

    @* ── Contacts ─────────────────────────────────────────────────────────── *@
    <div class="d-flex align-items-center gap-2 mb-2 mt-3">
        <h5 class="mb-0">Contacts</h5>
        <AuthorizeView Roles="FarmAdmin">
            <Authorized>
                <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="StartAddContact">+ Add Contact</button>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (_customer.Type == CustomerType.Wholesale && !_customer.Contacts.Any())
    {
        <div class="alert alert-warning py-2">Wholesale customers should have at least one contact.</div>
    }

    @if (_contactError is not null)
    {
        <div class="alert alert-danger d-flex justify-content-between align-items-center py-2">
            <span>@_contactError</span>
            <button type="button" class="btn-close btn-sm" @onclick="() => _contactError = null"></button>
        </div>
    }

    @if (_showContactForm)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="card-title">@(_editingContactId.HasValue ? "Edit Contact" : "New Contact")</h6>
                <EditForm Model="_contactForm" OnValidSubmit="SaveContactAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label">First Name *</label>
                            <InputText @bind-Value="_contactForm.FirstName" class="form-control form-control-sm" />
                            <ValidationMessage For="() => _contactForm.FirstName" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Last Name *</label>
                            <InputText @bind-Value="_contactForm.LastName" class="form-control form-control-sm" />
                            <ValidationMessage For="() => _contactForm.LastName" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Role</label>
                            <InputSelect @bind-Value="_contactForm.Role" class="form-select form-select-sm">
                                @foreach (var role in Enum.GetValues<ContactRole>())
                                {
                                    <option value="@role">@role</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Email</label>
                            <InputText @bind-Value="_contactForm.Email" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-1">
                            <label class="form-label">Phone</label>
                            <InputText @bind-Value="_contactForm.Phone" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-1">
                            <label class="form-label">Mobile</label>
                            <InputText @bind-Value="_contactForm.Mobile" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="form-check mt-2">
                        <InputCheckbox @bind-Value="_contactForm.IsPrimary" class="form-check-input" id="contactIsPrimary" />
                        <label class="form-check-label" for="contactIsPrimary">Primary contact</label>
                    </div>
                    <div class="mt-2 d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-primary">Save</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showContactForm = false">Cancel</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (_customer.Contacts.Any())
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <AuthorizeView Roles="FarmAdmin">
                        <Authorized><th></th></Authorized>
                    </AuthorizeView>
                </tr>
            </thead>
            <tbody>
                @foreach (var contact in _customer.Contacts)
                {
                    <tr>
                        <td>@contact.FirstName @contact.LastName @(contact.IsPrimary ? "(Primary)" : "")</td>
                        <td>@contact.Role</td>
                        <td>@contact.Email</td>
                        <td>@(contact.Phone ?? contact.Mobile)</td>
                        <AuthorizeView Roles="FarmAdmin">
                            <Authorized>
                                <td class="text-end text-nowrap">
                                    @if (_pendingDeleteId == contact.Id)
                                    {
                                        <button class="btn btn-sm btn-danger me-1" @onclick="() => ConfirmDeleteContactAsync(contact.Id)">Confirm?</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _pendingDeleteId = null">Cancel</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => StartEditContact(contact)">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => _pendingDeleteId = contact.Id">Delete</button>
                                    }
                                </td>
                            </Authorized>
                        </AuthorizeView>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (!_showContactForm)
    {
        <p class="text-muted">No contacts on file.</p>
    }

    @if (_customer.Addresses.Any())
    {
        <h5>All Addresses</h5>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Label</th>
                    <th>Type</th>
                    <th>Address</th>
                    <th>Default</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var addr in _customer.Addresses)
                {
                    <tr>
                        <td>@addr.Label</td>
                        <td>@addr.Type</td>
                        <td>@addr.Line1, @addr.City, @addr.State @addr.PostalCode</td>
                        <td>@(addr.IsDefault ? "✓" : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="mt-3">
        <a href="/customers" class="btn btn-secondary">Back to List</a>
    </div>

    @* ── Insulated Schedule ──────────────────────────────────────────────── *@
    <div class="card mt-4">
        <div class="card-header d-flex align-items-center gap-2">
            <h5 class="mb-0">Insulated Schedule</h5>
            @if (_insulatedSo is not null)
            {
                <span class="badge @StandingOrderRules.StatusBadgeClass(_insulatedSo.Status)">@_insulatedSo.Status</span>
            }
            <AuthorizeView Roles="FarmAdmin">
                <Authorized>
                    @if (_insulatedSo is not null && StandingOrderRules.CanEdit(_insulatedSo.Status))
                    {
                        <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="ToggleSoEdit">
                            @(_soEditMode ? "Cancel" : "Edit")
                        </button>
                    }
                    else if (_insulatedSo is null)
                    {
                        <a href="/standing-orders/create?customerId=@Id&channel=Insulated" class="btn btn-sm btn-primary ms-auto">Create Schedule</a>
                    }
                </Authorized>
            </AuthorizeView>
        </div>
        <div class="card-body">
            @if (_soError is not null)
            {
                <div class="alert alert-danger alert-dismissible py-2">
                    @_soError
                    <button type="button" class="btn-close" @onclick="() => _soError = null"></button>
                </div>
            }
            @if (_insulatedSo is null)
            {
                <p class="text-muted mb-0">No active Insulated schedule for this customer.</p>
            }
            else if (_soEditMode)
            {
                <EditForm Model="_soEditForm" OnValidSubmit="SaveSoEditAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Frequency</label>
                            <InputSelect @bind-Value="_soEditForm.Frequency" class="form-select">
                                @foreach (var f in Enum.GetValues<OrderFrequency>().Where(f => f != OrderFrequency.Stopped))
                                {
                                    <option value="@f">@f</option>
                                }
                            </InputSelect>
                        </div>
                        @if (_soEditForm.Frequency == OrderFrequency.Monthly)
                        {
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Monthly Week</label>
                                <InputSelect @bind-Value="_soEditForm.MonthlyWeek" class="form-select">
                                    <option value="">— select —</option>
                                    @foreach (var w in Enum.GetValues<MonthlyWeek>())
                                    {
                                        <option value="@w">@w</option>
                                    }
                                </InputSelect>
                            </div>
                        }
                    </div>
                    <h6>Box Lines</h6>
                    @foreach (var line in _soEditForm.Lines)
                    {
                        var captureLine = line;
                        <div class="row g-2 mb-2 align-items-end">
                            <div class="col-auto">
                                <label class="form-label">Box Size</label>
                                <InputSelect @bind-Value="captureLine.BoxSize" class="form-select form-select-sm">
                                    @foreach (var sz in Enum.GetValues<InsulatedBoxSize>())
                                    {
                                        <option value="@sz">@sz</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-auto">
                                <label class="form-label">Qty</label>
                                <InputNumber @bind-Value="captureLine.Qty" class="form-control form-control-sm" style="width:70px" min="1" />
                            </div>
                            <div class="col-auto">
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        @onclick="() => _soEditForm.Lines.Remove(captureLine)">✕</button>
                            </div>
                        </div>
                    }
                    <button type="button" class="btn btn-sm btn-outline-secondary mb-3"
                            @onclick="() => _soEditForm.Lines.Add(new SoLineEditItem())">+ Add Line</button>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-primary">Save</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _soEditMode = false">Cancel</button>
                    </div>
                </EditForm>
            }
            else
            {
                <dl class="row mb-2">
                    <dt class="col-sm-3">Season</dt>
                    <dd class="col-sm-9">@_insulatedSo.SeasonYear</dd>
                    <dt class="col-sm-3">Frequency</dt>
                    <dd class="col-sm-9">@_insulatedSo.Frequency@(_insulatedSo.MonthlyWeek is not null ? $" ({_insulatedSo.MonthlyWeek})" : "")</dd>
                    <dt class="col-sm-3">Est. Weekly</dt>
                    <dd class="col-sm-9">@_insulatedSo.TotalBoxes box@(_insulatedSo.TotalBoxes != 1 ? "es" : "") · @_insulatedSo.TotalWeightLbs.ToString("0.#") lbs · @_insulatedSo.TotalAmount.ToString("C")</dd>
                </dl>
                @if (_insulatedSo.Lines.Any())
                {
                    <table class="table table-sm mb-2" style="width:auto">
                        <thead><tr><th>Box Size</th><th>Qty</th></tr></thead>
                        <tbody>
                            @foreach (var l in _insulatedSo.Lines)
                            {
                                <tr><td>@l.BoxSize</td><td>@l.Qty</td></tr>
                            }
                        </tbody>
                    </table>
                }
                @if (_insulatedSo.Skips.Any())
                {
                    <p class="mb-1"><strong>Skips:</strong> @string.Join(", ", _insulatedSo.Skips.Select(s => s.WeekOf.ToString("MMM d")))</p>
                }

                <AuthorizeView Roles="FarmAdmin">
                    <Authorized>
                        <div class="d-flex gap-2 mb-3 flex-wrap">
                            @if (StandingOrderRules.CanPause(_insulatedSo.Status))
                            {
                                <button class="btn btn-sm btn-warning" @onclick="PauseSoAsync">Pause</button>
                            }
                            @if (StandingOrderRules.CanResume(_insulatedSo.Status))
                            {
                                <button class="btn btn-sm btn-success" @onclick="ResumeSoAsync">Resume</button>
                            }
                            @if (StandingOrderRules.CanStop(_insulatedSo.Status))
                            {
                                @if (_confirmStop)
                                {
                                    <button class="btn btn-sm btn-danger" @onclick="StopSoAsync">Confirm Stop</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmStop = false">Cancel</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmStop = true">Stop</button>
                                }
                            }
                            @if (!_showSkipForm)
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showSkipForm = true">Add Skip Week</button>
                            }
                        </div>
                        @if (_showSkipForm)
                        {
                            <div class="d-flex gap-2 align-items-end mb-3">
                                <div>
                                    <label class="form-label mb-1 fw-semibold">Skip week of</label>
                                    <InputDate @bind-Value="_skipDate" class="form-control form-control-sm" style="width:175px" />
                                </div>
                                <button class="btn btn-sm btn-primary" @onclick="AddSkipAsync">Add Skip</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showSkipForm = false">Cancel</button>
                            </div>
                        }
                    </Authorized>
                </AuthorizeView>

                @if (_recentInsulatedOrders.Length > 0)
                {
                    <h6 class="mb-2">Recent Orders</h6>
                    <table class="table table-sm table-hover mb-1" style="width:auto">
                        <tbody>
                            @foreach (var o in _recentInsulatedOrders)
                            {
                                <tr>
                                    <td>@o.WeekOf.ToString("MMM d, yyyy")</td>
                                    <td><span class="badge @OrderLifecycleRules.StatusBadgeClass(o.Status)">@o.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <a href="/orders?customerId=@Id&channel=Insulated" class="small">View all Insulated orders →</a>
            }
        </div>
    </div>

    @* ── FedEx Orders ────────────────────────────────────────────────────── *@
    <div class="card mt-3 mb-4">
        <div class="card-header d-flex align-items-center gap-2">
            <h5 class="mb-0">FedEx Orders</h5>
            <AuthorizeView Roles="FarmAdmin">
                <Authorized>
                    <a href="/orders/create?customerId=@Id&channel=FedEx" class="btn btn-sm btn-primary ms-auto">+ New FedEx Order</a>
                </Authorized>
            </AuthorizeView>
        </div>
        <div class="card-body">
            @if (_recentFedExOrders.Length == 0)
            {
                <p class="text-muted mb-0">No FedEx orders yet.</p>
            }
            else
            {
                <table class="table table-sm table-hover mb-1">
                    <tbody>
                        @foreach (var o in _recentFedExOrders)
                        {
                            <tr>
                                <td>@o.WeekOf.ToString("MMM d, yyyy")</td>
                                <td>@o.TotalQty item@(o.TotalQty != 1 ? "s" : "") · @o.TotalAmount.ToString("C")</td>
                                <td><span class="badge @OrderLifecycleRules.StatusBadgeClass(o.Status)">@o.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <a href="/orders?customerId=@Id&channel=FedEx" class="small">View all FedEx orders →</a>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private CustomerDetail? _customer;
    private bool _keyEditMode;
    private string _keyEditValue = string.Empty;
    private string? _keyError;
    private readonly CancellationTokenSource _cts = new();

    // ── Insulated schedule state ──────────────────────────────────────────
    private StandingOrderDetail? _insulatedSo;
    private OrderSummary[] _recentInsulatedOrders = [];
    private OrderSummary[] _recentFedExOrders = [];
    private bool _soEditMode;
    private SoEditForm _soEditForm = new();
    private string? _soError;
    private bool _confirmStop;
    private bool _showSkipForm;
    private DateTime _skipDate = DateTime.Today;

    private sealed class SoEditForm
    {
        public OrderFrequency Frequency { get; set; } = OrderFrequency.Weekly;
        public MonthlyWeek? MonthlyWeek { get; set; }
        public List<SoLineEditItem> Lines { get; set; } = [];
    }

    private sealed class SoLineEditItem
    {
        public InsulatedBoxSize BoxSize { get; set; } = InsulatedBoxSize.TwelveLb;
        public int Qty { get; set; } = 1;
    }

    // ── Contact state ────────────────────────────────────────────────────────
    private ContactForm _contactForm = new();
    private Guid? _editingContactId;
    private bool _showContactForm;
    private Guid? _pendingDeleteId;
    private string? _contactError;

    private sealed class ContactForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "First name is required.")]
        public string FirstName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Last name is required.")]
        public string LastName { get; set; } = string.Empty;

        public ContactRole Role { get; set; } = ContactRole.Primary;
        public string? Email { get; set; }
        public string? Phone { get; set; }
        public string? Mobile { get; set; }
        public bool IsPrimary { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _customer = await CustomerApi.GetCustomerAsync(Id, _cts.Token);

        var soTask = OrderApi.GetStandingOrdersAsync(Id, _cts.Token);
        var insulatedOrdersTask = OrderApi.GetOrdersAsync(Id, cancellationToken: _cts.Token);
        await Task.WhenAll(soTask, insulatedOrdersTask);

        var allSos = await soTask;
        _insulatedSo = allSos.FirstOrDefault(s => s.Channel == "Insulated");

        var allOrders = await insulatedOrdersTask;
        _recentInsulatedOrders = allOrders
            .Where(o => o.Channel == "Insulated")
            .OrderByDescending(o => o.WeekOf)
            .Take(5).ToArray();
        _recentFedExOrders = allOrders
            .Where(o => o.Channel == "FedEx")
            .OrderByDescending(o => o.WeekOf)
            .Take(5).ToArray();
    }

    // ── Customer Key ─────────────────────────────────────────────────────────
    private void StartKeyEdit()
    {
        _keyEditValue = _customer?.CustomerKey ?? string.Empty;
        _keyEditMode  = true;
        _keyError     = null;
    }

    private async Task GenerateKeyAsync()
    {
        _keyError = null;
        var result = await CustomerApi.GenerateCustomerKeyAsync(Id, _cts.Token);
        if (result is null)
        {
            _keyError = "Failed to generate key.";
            return;
        }
        _customer = _customer! with { CustomerKey = result.CustomerKey, CustomerKeyCollision = result.HasCollision };
    }

    private async Task SaveKeyAsync()
    {
        _keyError = null;
        if (string.IsNullOrWhiteSpace(_keyEditValue))
        {
            _keyError = "Key cannot be empty.";
            return;
        }
        var result = await CustomerApi.UpdateCustomerKeyAsync(Id, _keyEditValue.Trim(), _cts.Token);
        if (result is null)
        {
            _keyError = "Key already in use by another customer.";
            return;
        }
        _customer     = _customer! with { CustomerKey = result.CustomerKey, CustomerKeyCollision = result.HasCollision };
        _keyEditMode  = false;
    }

    // ── Contacts ─────────────────────────────────────────────────────────────
    private void StartAddContact()
    {
        _contactForm       = new ContactForm();
        _editingContactId  = null;
        _showContactForm   = true;
        _contactError      = null;
        _pendingDeleteId   = null;
    }

    private void StartEditContact(ContactDto contact)
    {
        _contactForm = new ContactForm
        {
            FirstName = contact.FirstName,
            LastName  = contact.LastName,
            Role      = contact.Role,
            Email     = contact.Email,
            Phone     = contact.Phone,
            Mobile    = contact.Mobile,
            IsPrimary = contact.IsPrimary,
        };
        _editingContactId = contact.Id;
        _showContactForm  = true;
        _contactError     = null;
        _pendingDeleteId  = null;
    }

    private async Task SaveContactAsync()
    {
        _contactError = null;
        ContactDto? result;

        if (_editingContactId.HasValue)
        {
            var req = new UpdateContactRequest(
                _contactForm.Role, _contactForm.FirstName, _contactForm.LastName,
                _contactForm.Email, _contactForm.Phone, _contactForm.Mobile, _contactForm.IsPrimary);
            result = await CustomerApi.UpdateContactAsync(Id, _editingContactId.Value, req, _cts.Token);
            if (result is null)
            {
                _contactError = "Failed to update contact.";
                return;
            }
            var updated = _customer!.Contacts
                .Select(c => c.Id == _editingContactId.Value ? result : c)
                .ToArray();
            _customer = _customer with { Contacts = updated };
        }
        else
        {
            var req = new CreateContactRequest(
                _contactForm.Role, _contactForm.FirstName, _contactForm.LastName,
                _contactForm.Email, _contactForm.Phone, _contactForm.Mobile, _contactForm.IsPrimary);
            result = await CustomerApi.CreateContactAsync(Id, req, _cts.Token);
            if (result is null)
            {
                _contactError = "Failed to create contact.";
                return;
            }
            _customer = _customer! with { Contacts = [.. _customer.Contacts, result] };
        }

        _showContactForm  = false;
        _editingContactId = null;
    }

    private async Task ConfirmDeleteContactAsync(Guid contactId)
    {
        _contactError = null;
        var ok = await CustomerApi.DeleteContactAsync(Id, contactId, _cts.Token);
        if (!ok)
        {
            _contactError = "Failed to delete contact.";
        }
        else
        {
            _customer = _customer! with { Contacts = _customer.Contacts.Where(c => c.Id != contactId).ToArray() };
        }
        _pendingDeleteId = null;
    }

    // ── Insulated schedule actions ────────────────────────────────────────
    private void ToggleSoEdit()
    {
        if (!_soEditMode && _insulatedSo is not null)
        {
            _soEditForm = new SoEditForm
            {
                Frequency   = Enum.Parse<OrderFrequency>(_insulatedSo.Frequency),
                MonthlyWeek = _insulatedSo.MonthlyWeek is not null
                                  ? Enum.Parse<MonthlyWeek>(_insulatedSo.MonthlyWeek)
                                  : null,
                Lines       = _insulatedSo.Lines
                                  .Select(l => new SoLineEditItem
                                  {
                                      BoxSize = Enum.Parse<InsulatedBoxSize>(l.BoxSize),
                                      Qty     = l.Qty
                                  }).ToList()
            };
        }
        _soEditMode = !_soEditMode;
    }

    private async Task PauseSoAsync()
    {
        if (_insulatedSo is null) return;
        _soError = null;
        var ok = await OrderApi.PauseStandingOrderAsync(Id, _insulatedSo.Id, _cts.Token);
        if (ok) _insulatedSo = await OrderApi.GetStandingOrderAsync(Id, _insulatedSo.Id, _cts.Token);
        else _soError = "Failed to pause schedule.";
    }

    private async Task ResumeSoAsync()
    {
        if (_insulatedSo is null) return;
        _soError = null;
        var ok = await OrderApi.ResumeStandingOrderAsync(Id, _insulatedSo.Id, _cts.Token);
        if (ok) _insulatedSo = await OrderApi.GetStandingOrderAsync(Id, _insulatedSo.Id, _cts.Token);
        else _soError = "Failed to resume schedule.";
    }

    private async Task StopSoAsync()
    {
        if (_insulatedSo is null) return;
        _soError = null;
        var ok = await OrderApi.StopStandingOrderAsync(Id, _insulatedSo.Id, _cts.Token);
        if (ok) _insulatedSo = await OrderApi.GetStandingOrderAsync(Id, _insulatedSo.Id, _cts.Token);
        else _soError = "Failed to stop schedule.";
        _confirmStop = false;
    }

    private async Task AddSkipAsync()
    {
        if (_insulatedSo is null) return;
        _soError = null;
        if (!StandingOrderRules.CanAddSkip(_skipDate, DateTime.UtcNow))
        {
            _soError = "Skip deadline has passed (Friday cutoff).";
            return;
        }
        var ok = await OrderApi.AddSkipWeekAsync(Id, _insulatedSo.Id, _skipDate, _cts.Token);
        if (ok)
        {
            _insulatedSo = await OrderApi.GetStandingOrderAsync(Id, _insulatedSo.Id, _cts.Token);
            _showSkipForm = false;
        }
        else _soError = "Failed to add skip week.";
    }

    private async Task SaveSoEditAsync()
    {
        if (_insulatedSo is null) return;
        _soError = null;
        var req = new WebUpdateStandingOrderRequest(
            _soEditForm.Frequency,
            _soEditForm.MonthlyWeek,
            _insulatedSo.IsSample,
            _insulatedSo.ContactId,
            _soEditForm.Lines.Select(l => new StandingOrderLineRequest(l.BoxSize, l.Qty)).ToList());
        try
        {
            _insulatedSo = await OrderApi.UpdateStandingOrderAsync(Id, _insulatedSo.Id, req, _cts.Token);
            _soEditMode = false;
        }
        catch (HttpRequestException ex)
        {
            _soError = ex.Message;
        }
    }

    public void Dispose() => _cts.Cancel();
}
