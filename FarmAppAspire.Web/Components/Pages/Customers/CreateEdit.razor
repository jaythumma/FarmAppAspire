@page "/customers/create"
@page "/customers/{Id:guid}/edit"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "FarmAdmin")]
@inject CustomerApiClient CustomerApi
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@(IsEdit ? "Edit Customer" : "New Customer")</PageTitle>

<h1>@(IsEdit ? "Edit Customer" : "New Customer")</h1>

<EditForm Model="_model" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />

    <div class="row g-4">
        @* ── Left column: Customer Info ──────────────────────────────────── *@
        <div class="col-lg-5">
            <h5>Customer Info</h5>

            <div class="mb-3">
                <label class="form-label">Type</label>
                <InputSelect @bind-Value="_model.Type" class="form-select">
                    <option value="Retail">Retail</option>
                    <option value="Wholesale">Wholesale</option>
                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label">Channel</label>
                <InputSelect @bind-Value="_model.ChannelType" class="form-select">
                    <option value="Direct">Direct</option>
                    <option value="Amazon">Amazon</option>
                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label">Display Name *</label>
                <InputText @bind-Value="_model.DisplayName" class="form-control" />
                <ValidationMessage For="() => _model.DisplayName" />
            </div>

            <div class="mb-3">
                <label class="form-label">Primary Email</label>
                <InputText @bind-Value="_model.PrimaryEmail" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Primary Phone</label>
                <InputText @bind-Value="_model.PrimaryPhone" class="form-control" />
            </div>

            @if (_model.Type == CustomerType.Wholesale)
            {
                <div class="mb-3">
                    <label class="form-label">Company Name *</label>
                    <InputText @bind-Value="_model.CompanyName" class="form-control" />
                    <ValidationMessage For="() => _model.CompanyName" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Tax ID</label>
                    <InputText @bind-Value="_model.TaxId" class="form-control" />
                </div>
            }
        </div>

        @* ── Right column: Address ───────────────────────────────────────── *@
        <div class="col-lg-7">
            <h5>Shipping Address</h5>
            <div class="row">
                <div class="col-12 mb-3">
                    <label class="form-label">Line 1 *</label>
                    <InputText @bind-Value="_model.ShippingLine1" class="form-control" />
                    <ValidationMessage For="() => _model.ShippingLine1" />
                </div>
                <div class="col-12 mb-3">
                    <label class="form-label">Line 2</label>
                    <InputText @bind-Value="_model.ShippingLine2" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">City *</label>
                    <InputText @bind-Value="_model.ShippingCity" class="form-control" />
                    <ValidationMessage For="() => _model.ShippingCity" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">State *</label>
                    <InputSelect @bind-Value="_model.ShippingState">
                        <option value="">-- Select --</option>
                        @foreach (var (abbr, stateName) in UsStates)
                        {
                            <option value="@abbr">@stateName</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _model.ShippingState" />
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Postal Code *</label>
                    <InputText @bind-Value="_model.ShippingPostalCode" class="form-control" />
                    <ValidationMessage For="() => _model.ShippingPostalCode" />
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Country *</label>
                    <InputText @bind-Value="_model.ShippingCountry" class="form-control" />
                    <ValidationMessage For="() => _model.ShippingCountry" />
                </div>
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="billingUsesShipping"
                           @bind="_model.BillingUsesShipping" />
                    <label class="form-check-label" for="billingUsesShipping">Same as shipping address</label>
                </div>
            </div>

            @if (!_model.BillingUsesShipping)
            {
                <h5>Billing Address</h5>
                <div class="row">
                    <div class="col-12 mb-3">
                        <label class="form-label">Line 1</label>
                        <InputText @bind-Value="_model.BillingLine1" class="form-control" />
                    </div>
                    <div class="col-12 mb-3">
                        <label class="form-label">Line 2</label>
                        <InputText @bind-Value="_model.BillingLine2" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">City</label>
                        <InputText @bind-Value="_model.BillingCity" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">State</label>
                        <InputSelect @bind-Value="_model.BillingState">
                            <option value="">-- Select --</option>
                            @foreach (var (abbr, stateName) in UsStates)
                            {
                                <option value="@abbr">@stateName</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-2 mb-3">
                        <label class="form-label">Postal Code</label>
                        <InputText @bind-Value="_model.BillingPostalCode" class="form-control" />
                    </div>
                    <div class="col-md-2 mb-3">
                        <label class="form-label">Country</label>
                        <InputText @bind-Value="_model.BillingCountry" class="form-control" />
                    </div>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger mt-3">@_errorMessage</div>
    }

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/customers" class="btn btn-secondary ms-2">Cancel</a>
    </div>
</EditForm>

@code {
    [Parameter] public Guid? Id { get; set; }
    private bool IsEdit => Id.HasValue;

    private readonly FormModel _model = new();
    private string? _errorMessage;
    private CustomerDetail? _existing;
    private readonly CancellationTokenSource _cts = new();

    private static readonly (string Code, string Name)[] UsStates =
    [
        ("AL", "Alabama"), ("AK", "Alaska"), ("AZ", "Arizona"), ("AR", "Arkansas"),
        ("CA", "California"), ("CO", "Colorado"), ("CT", "Connecticut"), ("DE", "Delaware"),
        ("FL", "Florida"), ("GA", "Georgia"), ("HI", "Hawaii"), ("ID", "Idaho"),
        ("IL", "Illinois"), ("IN", "Indiana"), ("IA", "Iowa"), ("KS", "Kansas"),
        ("KY", "Kentucky"), ("LA", "Louisiana"), ("ME", "Maine"), ("MD", "Maryland"),
        ("MA", "Massachusetts"), ("MI", "Michigan"), ("MN", "Minnesota"), ("MS", "Mississippi"),
        ("MO", "Missouri"), ("MT", "Montana"), ("NE", "Nebraska"), ("NV", "Nevada"),
        ("NH", "New Hampshire"), ("NJ", "New Jersey"), ("NM", "New Mexico"), ("NY", "New York"),
        ("NC", "North Carolina"), ("ND", "North Dakota"), ("OH", "Ohio"), ("OK", "Oklahoma"),
        ("OR", "Oregon"), ("PA", "Pennsylvania"), ("RI", "Rhode Island"), ("SC", "South Carolina"),
        ("SD", "South Dakota"), ("TN", "Tennessee"), ("TX", "Texas"), ("UT", "Utah"),
        ("VT", "Vermont"), ("VA", "Virginia"), ("WA", "Washington"), ("WV", "West Virginia"),
        ("WI", "Wisconsin"), ("WY", "Wyoming")
    ];

    protected override async Task OnInitializedAsync()
    {
        if (IsEdit && Id.HasValue)
        {
            _existing = await CustomerApi.GetCustomerAsync(Id.Value, _cts.Token);
            if (_existing is not null)
            {
                _model.Type = _existing.Type;
                _model.ChannelType = _existing.ChannelType;
                _model.DisplayName = _existing.DisplayName;
                _model.PrimaryEmail = _existing.PrimaryEmail;
                _model.PrimaryPhone = _existing.PrimaryPhone;
                _model.CompanyName = _existing.CompanyName;
                _model.TaxId = _existing.TaxId;
                _model.BillingUsesShipping = _existing.BillingUsesShipping;

                var shipping = _existing.Addresses
                    .FirstOrDefault(a => a.Type == AddressType.Shipping);
                if (shipping is not null)
                {
                    _model.ShippingLine1 = shipping.Line1;
                    _model.ShippingLine2 = shipping.Line2;
                    _model.ShippingCity = shipping.City;
                    _model.ShippingState = shipping.State;
                    _model.ShippingPostalCode = shipping.PostalCode;
                    _model.ShippingCountry = shipping.Country;
                }

                var billing = _existing.Addresses
                    .FirstOrDefault(a => a.Type == AddressType.Billing);
                if (billing is not null)
                {
                    _model.BillingLine1 = billing.Line1;
                    _model.BillingLine2 = billing.Line2;
                    _model.BillingCity = billing.City;
                    _model.BillingState = billing.State;
                    _model.BillingPostalCode = billing.PostalCode;
                    _model.BillingCountry = billing.Country;
                }
            }
        }
    }

    private bool HasCompleteBillingAddress() =>
        !_model.BillingUsesShipping &&
        !string.IsNullOrWhiteSpace(_model.BillingLine1) &&
        !string.IsNullOrWhiteSpace(_model.BillingCity) &&
        !string.IsNullOrWhiteSpace(_model.BillingState) &&
        !string.IsNullOrWhiteSpace(_model.BillingPostalCode) &&
        !string.IsNullOrWhiteSpace(_model.BillingCountry);

    private async Task SaveAsync()
    {
        _errorMessage = null;

        try
        {
            if (IsEdit && Id.HasValue)
            {
                var updateReq = new UpdateCustomerRequest(
                    DisplayName: _model.DisplayName,
                    CompanyName: _model.Type == CustomerType.Wholesale ? _model.CompanyName : null,
                    TaxId: _model.TaxId,
                    PaymentTerms: null,
                    PrimaryEmail: _model.PrimaryEmail,
                    PrimaryPhone: _model.PrimaryPhone,
                    Notes: null,
                    BillingUsesShipping: _model.BillingUsesShipping,
                    ChannelType: _model.ChannelType);
                await CustomerApi.UpdateCustomerAsync(Id.Value, updateReq, _cts.Token);

                if (HasCompleteBillingAddress())
                {
                    var existingBilling = _existing?.Addresses
                        .FirstOrDefault(a => a.Type == AddressType.Billing);

                    if (existingBilling is not null)
                    {
                        await CustomerApi.UpdateAddressAsync(Id.Value, existingBilling.Id,
                            new UpdateAddressRequest(
                                Label: "Billing",
                                Type: AddressType.Billing,
                                Line1: _model.BillingLine1!,
                                Line2: _model.BillingLine2,
                                City: _model.BillingCity!,
                                State: _model.BillingState!,
                                PostalCode: _model.BillingPostalCode!,
                                Country: _model.BillingCountry!,
                                IsDefault: existingBilling.IsDefault),
                            _cts.Token);
                    }
                    else
                    {
                        await CustomerApi.CreateAddressAsync(Id.Value,
                            new CreateAddressRequest(
                                Label: "Billing",
                                Type: AddressType.Billing,
                                Line1: _model.BillingLine1!,
                                Line2: _model.BillingLine2,
                                City: _model.BillingCity!,
                                State: _model.BillingState!,
                                PostalCode: _model.BillingPostalCode!,
                                Country: _model.BillingCountry!,
                                IsDefault: false),
                            _cts.Token);
                    }
                }

                Nav.NavigateTo($"/customers/{Id.Value}");
            }
            else
            {
                AddressFields? billingAddress = null;
                if (HasCompleteBillingAddress())
                {
                    billingAddress = new AddressFields(
                        _model.BillingLine1!,
                        _model.BillingLine2,
                        _model.BillingCity!,
                        _model.BillingState!,
                        _model.BillingPostalCode!,
                        _model.BillingCountry!);
                }

                var createReq = new CreateCustomerRequest(
                    Type: _model.Type,
                    DisplayName: _model.DisplayName,
                    CompanyName: _model.Type == CustomerType.Wholesale ? _model.CompanyName : null,
                    TaxId: _model.TaxId,
                    PaymentTerms: null,
                    PrimaryEmail: _model.PrimaryEmail,
                    PrimaryPhone: _model.PrimaryPhone,
                    Notes: null,
                    ShippingAddress: new AddressFields(
                        _model.ShippingLine1,
                        _model.ShippingLine2,
                        _model.ShippingCity,
                        _model.ShippingState,
                        _model.ShippingPostalCode,
                        _model.ShippingCountry),
                    BillingUsesShipping: _model.BillingUsesShipping,
                    BillingAddress: billingAddress,
                    ChannelType: _model.ChannelType);

                var created = await CustomerApi.CreateCustomerAsync(createReq, _cts.Token);
                if (created is not null)
                    Nav.NavigateTo($"/customers/{created.Id}");
            }
        }
        catch (HttpRequestException hre)
        {
            _errorMessage = $"Error saving customer: {hre.Message}";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error saving customer: {ex.Message}";
        }
    }

    public void Dispose() => _cts.Cancel();

    private class FormModel
    {
        [Required]
        public CustomerType Type { get; set; } = CustomerType.Retail;

        public ChannelType ChannelType { get; set; } = ChannelType.Direct;

        [Required]
        public string DisplayName { get; set; } = string.Empty;

        public string? PrimaryEmail { get; set; }
        public string? PrimaryPhone { get; set; }
        public string? CompanyName { get; set; }
        public string? TaxId { get; set; }

        [Required]
        public string ShippingLine1 { get; set; } = string.Empty;
        public string? ShippingLine2 { get; set; }

        [Required]
        public string ShippingCity { get; set; } = string.Empty;

        [Required]
        public string ShippingState { get; set; } = string.Empty;

        [Required]
        public string ShippingPostalCode { get; set; } = string.Empty;

        [Required]
        public string ShippingCountry { get; set; } = string.Empty;

        public bool BillingUsesShipping { get; set; } = true;

        public string? BillingLine1 { get; set; }
        public string? BillingLine2 { get; set; }
        public string? BillingCity { get; set; }
        public string? BillingState { get; set; }
        public string? BillingPostalCode { get; set; }
        public string? BillingCountry { get; set; }
    }
}
