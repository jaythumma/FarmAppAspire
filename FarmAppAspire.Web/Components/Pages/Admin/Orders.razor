@page "/admin/orders"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "FarmAdmin")]
@inject OrderApiClient OrderApi
@implements IDisposable

<PageTitle>Order Administration</PageTitle>

<h1>Order Administration</h1>
<p class="text-muted mb-4">Generate weekly orders from active standing orders, or browse existing orders by week.</p>

@* ── Generate Instances ──────────────────────────────────────────────────── *@
<div class="card mb-4">
    <div class="card-header"><h5 class="mb-0">Generate Orders</h5></div>
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-auto">
                <label class="form-label fw-semibold">Pick any date in the target week</label>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="GeneratePreviousWeek">‹ Prev</button>
                    <InputDate @bind-Value="_generateDate"
                               class="form-control"
                               @bind-Value:after="OnGenerateDateChanged" />
                    <button class="btn btn-sm btn-outline-secondary" @onclick="GenerateNextWeek">Next ›</button>
                </div>
            </div>
            <div class="col-auto align-self-end pb-1">
                @if (_generateDate != default)
                {
                    <span class="text-muted">
                        Will generate for week of <strong>@SnapToMonday(_generateDate).ToString("ddd, MMM d, yyyy")</strong>
                    </span>
                }
            </div>
            <div class="col-auto align-self-end">
                <button class="btn btn-primary"
                        disabled="@(_generating || _generateDate == default)"
                        @onclick="GenerateAsync">
                    @if (_generating)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Generating…</span>
                    }
                    else
                    {
                        <span>Generate Orders</span>
                    }
                </button>
            </div>
        </div>

        @if (_generateError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0">@_generateError</div>
        }
    </div>
</div>

@* ── Generation Result ───────────────────────────────────────────────────── *@
@if (_generateResult is not null)
{
    <div class="card mb-4 @(_generateResult.GeneratedCount > 0 ? "border-success" : "border-secondary")">
        <div class="card-header @(_generateResult.GeneratedCount > 0 ? "bg-success text-white" : "bg-secondary text-white")">
            <div class="d-flex align-items-center gap-3">
                <span class="fs-5">
                    @(_generateResult.GeneratedCount > 0 ? "✅" : "ℹ️")
                    Week of <strong>@_generateResult.WeekOf.ToString("ddd, MMM d, yyyy")</strong>
                </span>
                <span class="badge bg-light @(_generateResult.GeneratedCount > 0 ? "text-success" : "text-secondary") fs-6 ms-auto">
                    @_generateResult.GeneratedCount created
                </span>
                <span class="badge bg-dark text-light fs-6">@_generateResult.SkippedCount skipped</span>
            </div>
        </div>
        @if (_generateResult.Orders.Any())
        {
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Customer Key</th>
                            <th>Customer</th>
                            <th>Channel</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Amount</th>
                            <th class="text-center">Sample</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inst in _generateResult.Orders)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(inst.CustomerKey))
                                    {
                                        <span class="fw-bold font-monospace text-primary">@inst.CustomerKey</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">No key</span>
                                    }
                                </td>
                                <td><a href="/customers/@inst.CustomerId">@inst.CustomerDisplayName</a></td>
                                <td>@inst.Channel</td>
                                <td class="text-center">@inst.TotalQty</td>
                                <td class="text-end">@inst.TotalAmount.ToString("C")</td>
                                <td class="text-center">@(inst.IsSample ? "Yes" : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="card-body text-muted fst-italic">
                No new orders were created — all already existed, or no active standing orders matched.
            </div>
        }
    </div>
}

@* ── Browse Instances by Week ────────────────────────────────────────────── *@
<div class="card">
    <div class="card-header">
        <div class="d-flex align-items-center gap-3">
            <h5 class="mb-0">Browse Orders by Week</h5>
            <div class="ms-auto d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-secondary" @onclick="PreviousWeek">‹ Prev</button>
                <span class="fw-semibold px-2">@SnapToMonday(_browseDate).ToString("ddd, MMM d, yyyy")</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="NextWeek">Next ›</button>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        @if (_browseError is not null)
        {
            <div class="alert alert-danger alert-dismissible m-3 mb-0" role="alert">
                <strong>Browse failed:</strong> @_browseError
                <button type="button" class="btn-close" @onclick="() => _browseError = null"></button>
            </div>
        }
        @if (_browseLoading)
        {
            <div class="p-3"><em>Loading...</em></div>
        }
        else if (_browseInstances is not null)
        {
            @if (!_browseInstances.Any())
            {
                <div class="p-3 text-muted fst-italic">No orders for this week.</div>
            }
            else
            {
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Customer Key</th>
                            <th>Customer</th>
                            <th>Channel</th>
                            <th>Status</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Amount</th>
                            <th class="text-center">Sample</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inst in _browseInstances)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(inst.CustomerKey))
                                    {
                                        <span class="fw-bold font-monospace text-primary">@inst.CustomerKey</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">No key</span>
                                    }
                                </td>
                                <td><a href="/customers/@inst.CustomerId">@inst.CustomerDisplayName</a></td>
                                <td>@inst.Channel</td>
                                <td>
                                    <span class="badge @StatusBadgeClass(inst.Status)">@inst.Status</span>
                                </td>
                                <td class="text-center">@inst.TotalQty</td>
                                <td class="text-end">@inst.TotalAmount.ToString("C")</td>
                                <td class="text-center">@(inst.IsSample ? "Yes" : "—")</td>
                                <td class="text-end">
                                    <a href="/orders/@inst.CustomerId/@inst.OrderId/edit"
                                       class="btn btn-sm btn-outline-primary">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>
</div>

@code {
    private DateTime _generateDate = DateTime.Today;
    private bool _generating;
    private string? _generateError;
    private GenerateOrdersResponse? _generateResult;

    private DateTime _browseDate = DateTime.Today;
    private WeekOrderSummary[]? _browseInstances;
    private bool _browseLoading;
    private string? _browseError;

    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        _generateDate = DateTime.Today;
        _browseDate   = DateTime.Today;
        await LoadBrowseAsync();
    }

    private void OnGenerateDateChanged()
    {
        _generateDate = SnapToMonday(_generateDate);
    }

    private void GeneratePreviousWeek()
    {
        _generateDate = SnapToMonday(_generateDate).AddDays(-7);
    }

    private void GenerateNextWeek()
    {
        _generateDate = SnapToMonday(_generateDate).AddDays(7);
    }

    private static DateTime SnapToMonday(DateTime date)
    {
        var days = ((int)date.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
        return date.Date.AddDays(-days);
    }

    private async Task GenerateAsync()
    {
        _generating     = true;
        _generateError  = null;
        _generateResult = null;

        try
        {
            _generateResult = await OrderApi.GenerateOrdersAsync(
                SnapToMonday(_generateDate), _cts.Token);

            if (_generateResult is null)
                _generateError = "Generation failed — check that the service is running and you have the X-User-Id header configured.";
        }
        catch (OperationCanceledException)
        {
            // navigation away — stay silent
        }
        catch (Exception ex)
        {
            _generateError = ex.Message;
        }
        finally
        {
            _generating = false;
        }

        _browseDate = _generateDate;
        await LoadBrowseAsync();
    }

    private async Task PreviousWeek()
    {
        _browseError = null;
        _browseDate  = SnapToMonday(_browseDate).AddDays(-7);
        await LoadBrowseAsync();
    }

    private async Task NextWeek()
    {
        _browseError = null;
        _browseDate  = SnapToMonday(_browseDate).AddDays(7);
        await LoadBrowseAsync();
    }

    private async Task LoadBrowseAsync()
    {
        _browseLoading = true;
        _browseError   = null;
        try
        {
            _browseInstances = await OrderApi.BrowseWeekOrdersAsync(
                SnapToMonday(_browseDate), _cts.Token);
        }
        catch (OperationCanceledException)
        {
            // navigation away — stay silent
        }
        catch (Exception ex)
        {
            _browseError     = ex.Message;
            _browseInstances = [];
        }
        finally
        {
            _browseLoading = false;
        }
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "Pending"   => "bg-secondary",
        "Harvested" => "bg-info text-dark",
        "Inspected" => "bg-primary",
        "Shipped"   => "bg-success",
        "Cancelled" => "bg-danger",
        _           => "bg-light text-dark"
    };

    public void Dispose() => _cts.Cancel();
}
