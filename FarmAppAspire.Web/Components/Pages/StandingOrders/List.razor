@page "/standing-orders"
@rendermode InteractiveServer
@attribute [Authorize]
@inject CustomerApiClient CustomerApi
@inject OrderApiClient OrderApi
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Standing Orders</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Standing Orders</h1>
    <a href="/standing-orders/create" class="btn btn-primary">New Standing Order</a>
</div>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @_errorMessage
        <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
    </div>
}

@if (_successMessage is not null)
{
    <div class="alert alert-success alert-dismissible" role="alert">
        @_successMessage
        <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
    </div>
}

<div class="row g-3 mb-3 align-items-end">
    <div class="col-auto">
        <label class="form-label fw-semibold">Customer</label>
        <select class="form-select" @bind="_selectedCustomerId" @bind:after="OnFilterChanged">
            <option value="">— all customers —</option>
            @foreach (var c in _customers)
            {
                <option value="@c.Id">@c.DisplayName</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label fw-semibold">Search</label>
        <input class="form-control" placeholder="Customer, status, frequency…"
               @bind="_searchText" @bind:event="oninput" @bind:after="OnFilterChanged" />
    </div>
    <div class="col-auto ms-auto">
        <label class="form-label fw-semibold">Page size</label>
        <select class="form-select" @bind="_pageSize" @bind:after="OnPageSizeChanged">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </div>
</div>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else if (_allOrders is not null)
{
    var filtered = StandingOrderListHelper.ApplyFilter(_allOrders, _searchText, _selectedCustomerId);
    var sorted   = _userSorted
        ? StandingOrderListHelper.ApplySort(filtered, _sortColumn, _sortAscending)
        : StandingOrderListHelper.ApplyDefaultSort(filtered);
    var totalPages = StandingOrderListHelper.TotalPages(sorted.Length, _pageSize);
    var paged      = StandingOrderListHelper.ApplyPage(sorted, _page, _pageSize);

    <div class="d-flex align-items-center gap-2 mb-2 text-muted small">
        <span>@sorted.Length order@(sorted.Length == 1 ? "" : "s")</span>
        @if (sorted.Length != _allOrders.Length)
        {
            <span>(filtered from @_allOrders.Length total)</span>
        }
    </div>

    @if (paged.Length == 0)
    {
        <div class="alert alert-info">No standing orders match the current filter.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>@SortHeader("Customer", "Customer")</th>
                        <th>@SortHeader("Status", "Status")</th>
                        <th>@SortHeader("Frequency", "Frequency")</th>
                        <th>@SortHeader("Start Week", "StartWeek")</th>
                        <th class="text-center">@SortHeader("Boxes", "Boxes")</th>
                        <th class="text-end">@SortHeader("Weight (lb)", "Weight")</th>
                        <th class="text-end">@SortHeader("Amount", "Amount")</th>
                        <th>Sample</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var so in paged)
                    {
                        <tr>
                            <td>
                                <div>@so.CustomerDisplayName</div>
                                <small class="text-muted">@so.CustomerChannelType / @so.CustomerType</small>
                            </td>
                            <td>
                                <span class="badge @StandingOrderRules.StatusBadgeClass(so.Status)">
                                    @so.Status
                                </span>
                            </td>
                            <td>@so.Frequency @(so.MonthlyWeek is not null ? $"({so.MonthlyWeek})" : "")</td>
                            <td>@so.StartWeek.ToString("MMM d, yyyy")</td>
                            <td class="text-center">@so.TotalBoxes</td>
                            <td class="text-end">@so.TotalWeightLbs.ToString("0.0")</td>
                            <td class="text-end">@so.TotalAmount.ToString("C")</td>
                            <td>@(so.IsSample ? "Yes" : "No")</td>
                            <td class="text-end">
                                <a href="/standing-orders/@so.CustomerId/@so.Id"
                                   class="btn btn-sm btn-outline-secondary me-1">View</a>
                                @if (StandingOrderRules.CanEdit(so.Status))
                                {
                                    <a href="/standing-orders/@so.CustomerId/@so.Id/edit"
                                       class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                }
                                @if (StandingOrderRules.CanPause(so.Status))
                                {
                                    <button class="btn btn-sm btn-outline-warning me-1"
                                            @onclick="() => PauseAsync(so)">Pause</button>
                                }
                                @if (StandingOrderRules.CanResume(so.Status))
                                {
                                    <button class="btn btn-sm btn-outline-success me-1"
                                            @onclick="() => ResumeAsync(so)">Resume</button>
                                }
                                @if (StandingOrderRules.CanStop(so.Status))
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => StopAsync(so)">Stop</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Standing orders pagination">
                <ul class="pagination pagination-sm">
                    <li class="page-item @(_page <= 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(_page - 1)">&laquo; Prev</button>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        var pageNum = p;
                        <li class="page-item @(_page == pageNum ? "active" : "")">
                            <button class="page-link" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                        </li>
                    }
                    <li class="page-item @(_page >= totalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(_page + 1)">Next &raquo;</button>
                    </li>
                </ul>
            </nav>
        }
    }
}

@code {
    private CustomerSummary[] _customers = [];
    private AllStandingOrderSummary[]? _allOrders;
    private string _selectedCustomerId = "";
    private string _searchText = "";
    private string? _errorMessage;
    private string? _successMessage;
    private bool _loading;
    private string _sortColumn = "StartWeek";
    private bool _sortAscending = false;
    private bool _userSorted = false;
    private int _page = 1;
    private int _pageSize = 25;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        var customersTask = CustomerApi.GetCustomersAsync(cancellationToken: _cts.Token);
        var ordersTask    = OrderApi.GetAllStandingOrdersAsync(_cts.Token);
        await Task.WhenAll(customersTask, ordersTask);
        _customers = customersTask.Result;
        _allOrders = ordersTask.Result;
        _loading = false;
    }

    private Task OnFilterChanged()
    {
        _page = 1;
        return Task.CompletedTask;
    }

    private Task OnPageSizeChanged()
    {
        _page = 1;
        return Task.CompletedTask;
    }

    private void GoToPage(int page) => _page = page;

    private void SortBy(string column)
    {
        if (_sortColumn == column)
            _sortAscending = !_sortAscending;
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
        _userSorted = true;
        _page = 1;
    }

    private RenderFragment SortHeader(string label, string column) => __builder =>
    {
        __builder.OpenElement(0, "button");
        __builder.AddAttribute(1, "class", "btn btn-link p-0 text-decoration-none text-dark fw-semibold");
        __builder.AddAttribute(2, "onclick", EventCallback.Factory.Create(this, () => SortBy(column)));
        __builder.AddContent(3, label);
        if (_userSorted && _sortColumn == column)
        {
            __builder.AddContent(4, " " + (_sortAscending ? "▲" : "▼"));
        }
        __builder.CloseElement();
    };

    private async Task ReloadAllOrdersAsync()
    {
        _allOrders = await OrderApi.GetAllStandingOrdersAsync(_cts.Token);
    }

    private async Task PauseAsync(AllStandingOrderSummary so)
    {
        _errorMessage = null;
        var ok = await OrderApi.PauseStandingOrderAsync(so.CustomerId, so.Id, _cts.Token);
        if (ok) { _successMessage = "Standing order paused."; await ReloadAllOrdersAsync(); }
        else _errorMessage = "Failed to pause standing order.";
    }

    private async Task ResumeAsync(AllStandingOrderSummary so)
    {
        _errorMessage = null;
        var ok = await OrderApi.ResumeStandingOrderAsync(so.CustomerId, so.Id, _cts.Token);
        if (ok) { _successMessage = "Standing order resumed."; await ReloadAllOrdersAsync(); }
        else _errorMessage = "Failed to resume standing order.";
    }

    private async Task StopAsync(AllStandingOrderSummary so)
    {
        _errorMessage = null;
        var ok = await OrderApi.StopStandingOrderAsync(so.CustomerId, so.Id, _cts.Token);
        if (ok) { _successMessage = "Standing order stopped."; await ReloadAllOrdersAsync(); }
        else _errorMessage = "Failed to stop standing order.";
    }

    public void Dispose() => _cts.Cancel();
}

