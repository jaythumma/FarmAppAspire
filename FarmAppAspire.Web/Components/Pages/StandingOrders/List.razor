@page "/standing-orders"
@rendermode InteractiveServer
@attribute [Authorize]
@inject CustomerApiClient CustomerApi
@inject OrderApiClient OrderApi
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Standing Orders</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Standing Orders</h1>
    <a href="/standing-orders/create" class="btn btn-primary">New Standing Order</a>
</div>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @_errorMessage
        <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
    </div>
}

@if (_successMessage is not null)
{
    <div class="alert alert-success alert-dismissible" role="alert">
        @_successMessage
        <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-auto">
        <label class="form-label fw-semibold">Customer</label>
        <select class="form-select" @bind="_selectedCustomerId" @bind:after="LoadOrdersAsync">
            <option value="">— select customer —</option>
            @foreach (var c in _customers)
            {
                <option value="@c.Id">@c.DisplayName</option>
            }
        </select>
    </div>
</div>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_orders is not null)
{
    @if (!_orders.Any())
    {
        <div class="alert alert-info">No standing orders found for this customer.</div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Status</th>
                    <th>Frequency</th>
                    <th>Start Week</th>
                    <th class="text-center">Boxes</th>
                    <th class="text-end">Weight (lb)</th>
                    <th class="text-end">Amount</th>
                    <th>Sample</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var so in _orders)
                {
                    <tr>
                        <td>
                            <span class="badge @StandingOrderRules.StatusBadgeClass(so.Status)">
                                @so.Status
                            </span>
                        </td>
                        <td>@so.Frequency @(so.MonthlyWeek is not null ? $"({so.MonthlyWeek})" : "")</td>
                        <td>@so.StartWeek.ToString("MMM d, yyyy")</td>
                        <td class="text-center">@so.TotalBoxes</td>
                        <td class="text-end">@so.TotalWeightLbs.ToString("0.0")</td>
                        <td class="text-end">@so.TotalAmount.ToString("C")</td>
                        <td>@(so.IsSample ? "Yes" : "No")</td>
                        <td class="text-end">
                            <a href="/standing-orders/@so.CustomerId/@so.Id"
                               class="btn btn-sm btn-outline-secondary me-1">View</a>
                            @if (StandingOrderRules.CanEdit(so.Status))
                            {
                                <a href="/standing-orders/@so.CustomerId/@so.Id/edit"
                                   class="btn btn-sm btn-outline-primary me-1">Edit</a>
                            }
                            @if (StandingOrderRules.CanPause(so.Status))
                            {
                                <button class="btn btn-sm btn-outline-warning me-1"
                                        @onclick="() => PauseAsync(so)">Pause</button>
                            }
                            @if (StandingOrderRules.CanResume(so.Status))
                            {
                                <button class="btn btn-sm btn-outline-success me-1"
                                        @onclick="() => ResumeAsync(so)">Resume</button>
                            }
                            @if (StandingOrderRules.CanStop(so.Status))
                            {
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => StopAsync(so)">Stop</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private CustomerSummary[] _customers = [];
    private StandingOrderDetail[]? _orders;
    private string _selectedCustomerId = "";
    private string? _errorMessage;
    private string? _successMessage;
    private bool _loading;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        _customers = await CustomerApi.GetCustomersAsync(cancellationToken: _cts.Token);
    }

    private async Task LoadOrdersAsync()
    {
        if (!Guid.TryParse(_selectedCustomerId, out var customerId)) return;
        _loading = true;
        _orders = await OrderApi.GetStandingOrdersAsync(customerId, _cts.Token);
        _loading = false;
    }

    private async Task PauseAsync(StandingOrderDetail so)
    {
        _errorMessage = null;
        var ok = await OrderApi.PauseStandingOrderAsync(so.CustomerId, so.Id, _cts.Token);
        if (ok) { _successMessage = "Standing order paused."; await LoadOrdersAsync(); }
        else _errorMessage = "Failed to pause standing order.";
    }

    private async Task ResumeAsync(StandingOrderDetail so)
    {
        _errorMessage = null;
        var ok = await OrderApi.ResumeStandingOrderAsync(so.CustomerId, so.Id, _cts.Token);
        if (ok) { _successMessage = "Standing order resumed."; await LoadOrdersAsync(); }
        else _errorMessage = "Failed to resume standing order.";
    }

    private async Task StopAsync(StandingOrderDetail so)
    {
        _errorMessage = null;
        var ok = await OrderApi.StopStandingOrderAsync(so.CustomerId, so.Id, _cts.Token);
        if (ok) { _successMessage = "Standing order stopped."; await LoadOrdersAsync(); }
        else _errorMessage = "Failed to stop standing order.";
    }

    public void Dispose() => _cts.Cancel();
}
