@page "/invoices"
@rendermode InteractiveServer
@attribute [Authorize]
@inject CustomerApiClient CustomerApi
@inject InvoiceApiClient InvoiceApi
@implements IDisposable

<PageTitle>Invoices</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Invoices</h1>
    <a href="/orders" class="btn btn-primary">Ship Orders</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-auto">
        <label class="form-label fw-semibold">Customer</label>
        <select class="form-select" @bind="_selectedCustomerId" @bind:after="LoadInvoicesAsync">
            <option value="">— select customer —</option>
            @foreach (var c in _customers)
            {
                <option value="@c.Id">@c.DisplayName</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label fw-semibold">Season Year</label>
        <select class="form-select" @bind="_seasonYearFilter" @bind:after="LoadInvoicesAsync">
            <option value="">All seasons</option>
            @foreach (var year in _availableSeasonYears)
            {
                <option value="@year">@year</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label fw-semibold">Channel</label>
        <select class="form-select" @bind="_channelFilter" @bind:after="LoadInvoicesAsync">
            <option value="">All channels</option>
            <option value="Insulated">Insulated</option>
            <option value="FedEx">FedEx</option>
        </select>
    </div>
    <div class="col-auto align-self-end">
        <button class="btn btn-primary" @onclick="LoadInvoicesAsync">Search</button>
    </div>
</div>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_invoices is not null)
{
    @if (!_invoices.Any())
    {
        <p>No invoices found.</p>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Label</th>
                    <th>Channel</th>
                    <th>Season</th>
                    <th>Week #</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inv in _invoices)
                {
                    <tr>
                        <td><strong>@inv.Label</strong></td>
                        <td>@inv.Channel</td>
                        <td>@inv.SeasonYear</td>
                        <td>@inv.SeekNum.ToString("D2")</td>
                        <td>@inv.CreatedAt.ToString("MMM d, yyyy")</td>
                        <td class="text-end">
                            <a href="/invoices/@_selectedCustomerId/@inv.Id"
                               class="btn btn-sm btn-outline-primary">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private CustomerSummary[] _customers = [];
    private InvoiceSummary[]? _invoices;
    private string _selectedCustomerId = "";
    private string _seasonYearFilter = "";
    private string _channelFilter = "";
    private bool _loading;
    private readonly CancellationTokenSource _cts = new();

    private static readonly int[] _availableSeasonYears =
        Enumerable.Range(DateTime.UtcNow.Year - 3, 5).Reverse().ToArray();

    protected override async Task OnInitializedAsync()
    {
        _customers = await CustomerApi.GetCustomersAsync(cancellationToken: _cts.Token);
    }

    private async Task LoadInvoicesAsync()
    {
        if (!Guid.TryParse(_selectedCustomerId, out var customerId)) return;
        _loading = true;
        int? seasonYear = int.TryParse(_seasonYearFilter, out var y) ? y : null;
        string? channel = string.IsNullOrEmpty(_channelFilter) ? null : _channelFilter;
        _invoices = await InvoiceApi.GetInvoicesAsync(customerId, seasonYear, channel, _cts.Token);
        _loading = false;
    }

    public void Dispose() => _cts.Cancel();
}
